    }
  ],
  "checks": [
    {
      "id": "SEC01-A01",
      "stream": "sponsor_and_scope",
      "reviewQuestion": "Formal project sponsor and accountable corporate owner identified",
      "privateProofRequired": "Documented sponsorship and accountable owner approved in corporate system"
    },
    {
      "id": "SEC01-A02",
      "stream": "sponsor_and_scope",
      "reviewQuestion": "Proposed pilot objective, authorized purpose, audience and access limits established",
      "privateProofRequired": "Signed scope, classification and authorized case categories"
    },
    {
      "id": "SEC01-A03",
      "stream": "sponsor_and_scope",
      "reviewQuestion": "Distinguish approval for restricted design from future real-pilot execution",
      "privateProofRequired": "Explicit exclusion of field execution, SAP writes and public publication"
    },
    {
      "id": "SEC01-L01",
      "stream": "oem_license",
      "reviewQuestion": "Identify license owner and permitted use of OEM documentation",
      "privateProofRequired": "OEM access and usage terms verified by authorized legal/licensing function"
    },
    {
      "id": "SEC01-L02",
      "stream": "oem_license",
      "reviewQuestion": "Decide whether copying, retention and derivative extraction are permitted",
      "privateProofRequired": "Copyright, replication, retention and access approval recorded privately"
    },
    {
      "id": "SEC01-L03",
      "stream": "oem_license",
      "reviewQuestion": "Confirm permissible source/provenance without treating generic OEM guide as serial effectivity",
      "privateProofRequired": "Licensed source identification and serial effectivity method proposed"
    },
    {
      "id": "SEC01-P01",
      "stream": "privacy_and_data",
      "reviewQuestion": "Assess data classes including machine, person, credential and restricted commercial information",
      "privateProofRequired": "Written data classification and lawful-use assessment in corporate vault"
    },
    {
      "id": "SEC01-P02",
      "stream": "privacy_and_data",
      "reviewQuestion": "Assess DPIA necessity and legal basis with competent privacy controller",
      "privateProofRequired": "Documented privacy officer/controller decision, not inferred by script"
    },
    {
      "id": "SEC01-P03",
      "stream": "privacy_and_data",
      "reviewQuestion": "Define private evidence access, external-publication prohibition and retention ownership",
      "privateProofRequired": "Access scope, least-privilege expectations and owner for retention review"
    }
  ],
