{
  "schema": "fmea-mining.technical-review-register.v1",
  "version": "1.3.8",
  "purpose": "Fila editorial de revisão; não registra aceite automático ou certificação de falha",
  "reviewStages": [
    {
      "state": "inferido_com_literatura_geral",
      "meaning": "Hipótese mecanicamente plausível fundamentada em referência geral",
      "requirements": [
        "cadeia_e_fontes_registradas",
        "hipoteses_concorrentes",
        "limites_e_contraprovas"
      ]
    },
    {
      "state": "revisado_por_especialista",
      "meaning": "Revisão técnica de coerência, sem validar aplicação OEM ou evento",
      "requirements": [
        "responsavel_tecnico_identificado",
        "segundo_revisor_independente_identificado",
        "decisao_e_racional",
        "efeito_local_e_sistemico_revisados"
      ]
    },
    {
      "state": "aplicabilidade_oem_confirmada",
      "meaning": "Arquitetura, ponto, teste e referências da configuração documentadas",
      "requirements": [
        "fabricante_modelo_prefixo_arranjo",
        "manual_revisao_efetividade",
        "componente_e_local_verificados",
        "limites_e_condicoes_de_ensaio"
      ]
    },
    {
      "state": "validado_com_evidencias",
      "meaning": "Hipóteses confrontadas com evidências rastreáveis; natureza didática ou real explicitada",
      "requirements": [
        "evidencia_independente_identificada",
        "instrumento_metodo_e_baseline",
        "alternativas_e_contraprovas_avaliadas",
        "direitos_de_publicacao",
        "status_do_tipo_de_evidencia"
      ]
    }
  ],
  "checks": [
    "fonte_primaria",
    "clareza_funcional",
    "mecanismo_vs_efeito",
    "contraprova",
    "teste_reprodutivel",
    "controle_de_seguranca",
    "oem_efetividade",
    "sap_tipo_de_objeto",
    "direito_de_publicacao"
  ],
  "promotionPolicy": {
    "automatedPromotion": false,
    "dualReviewRequired": true,
    "reviewerCannotBeSoleAuthor": true,
    "oemSerialEffectivityRequiredForApplicableClaims": true,
    "evidenceOriginMustBeExplicit": true,
    "withoutRealEvidenceMayBeValidatedAs": "didatica_revisada_nao_evento_empirico",
    "effectAndFailureStatusMustBeSeparate": true
  },
