{
  "schema": "fmea-mining.pm-maturity-policy.v1",
  "version": "1.3.60",
  "ontologyVersion": "1.3.23",
  "reviewDate": "2026-10-24",
  "principles": {
    "conceptCoverageIsNotHomologation": true,
    "publicSourceDoesNotEstablishSerialEffectivity": true,
    "syntheticEvidenceIsNotFieldEvidence": true,
    "unblockedRuleDoesNotMeanSapApproved": true,
    "noAutomaticSapRemap": true,
    "noAutomaticPriorityWithoutExistingP0P1": true,
    "noRiskScoreWithoutCriticalityData": true,
    "noApprovedPartNumberOrThresholdInferred": true,
    "noConsumerSideEffects": true
  },
  "gateDefinitions": [
    {
      "id": "semantic_model",
      "candidateStatus": "modeled_unvalidated",
      "approvalRequires": "revisão de modo de falha e função por especialista"
    },
    {
      "id": "source_traceability",
      "candidateStatus": "public_or_generic_references_catalogued",
      "approvalRequires": "proveniência e documento OEM efetivo para variante/série"
    },
    {
      "id": "serial_bom",
      "candidateStatus": "pending",
      "approvalRequires": "placa, configuração e BOM OEM por série"
    },
    {
      "id": "field_discrimination",
      "candidateStatus": "pending",
      "approvalRequires": "inspeção/medição real, contexto, método OEM e contraprova"
    },
    {
      "id": "damage_cause",
      "candidateStatus": "pending",
      "approvalRequires": "dano e causa física confirmados separadamente"
    },
    {
      "id": "sap_mapping",
      "candidateStatus": "pending_or_blocked",
      "approvalRequires": "validação de grupo/subgrupo/componente/dano/causa sem remapeamento automático"
    },
    {
      "id": "independent_engineering_review",
      "candidateStatus": "pending",
      "approvalRequires": "aprovação explícita e rastreável por engenheiro responsável"
    }
  ],
  "blockerOwners": {
    "damage_cause_not_permitted": "engenharia_de_confiabilidade_e_dados_mestres_sap",
    "component_not_registered": "engenharia_de_ativos_e_dados_mestres_sap",
    "subgroup_not_in_scope": "engenharia_de_sistemas_e_dados_mestres_sap"
  },
  "defaultReviewDiscipline": "engenharia_de_manutencao_e_especialista_oem",
  "priorityPolicy": "somente_P0_P1_documentados_na_pm_gap_review_demais_sem_classificacao",
  "acceptanceCriteria": {
    "minSeedCount": 25,
    "minBundleCount": 25,
    "expectedCandidateLinks": 115,
    "expectedSapExceptions": 10,
    "expectedP0": 5,
    "expectedP1": 5,
    "allowedRealEvents": 0,
    "allowedApprovedSapMappings": 0
  },
  "custody": "private_OEM_SAP_evidence_must_remain_in_authorized_environment"
}
