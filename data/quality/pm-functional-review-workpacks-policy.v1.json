{
  "schema": "fmea-mining.pm-functional-review-workpacks-policy.v1",
  "version": "1.3.68",
  "asOfDate": "2026-10-27",
  "predecessor": "1.3.67",
  "inputBoundary": "public_catalogue_counters_and_existing_exceptions_only_not_OEM_or_private_SAP",
  "documentaryTierOrder": [
    "P0",
    "P1",
    "UNRANKED"
  ],
  "tierSemantics": {
    "P0": "preexisting_documentary_exception_priority_not_safety_criticality",
    "P1": "preexisting_documentary_exception_priority_not_equipment_severity",
    "UNRANKED": "no_existing_exception_priority_do_not_infer"
  },
  "blockerRecipes": {
    "damage_cause_not_permitted": {
      "discipline": "maintenance_reliability_and_SAP_failure_taxonomy",
      "evidenceClasses": [
        "independent_physical_damage_or_condition",
        "mechanism_and_counterhypothesis",
        "SAP_approved_damage_cause_catalogue"
      ],
      "decisionQuestion": "Is the measured condition a physical component damage, a fluid/process condition or an inspection observation? Verify OEM applicability and SAP code permission independently.",
      "prohibitedShortcut": "reuse_existing_damage_cause_pair_or_conflate_fluids_with_component_damage"
    },
    "component_not_registered": {
      "discipline": "OEM_parts_and_SAP_technical_object_masterdata",
      "evidenceClasses": [
        "OEM_serial_effective_parts_book",
        "installed_function_and_object_type",
        "SAP_component_masterdata_scope"
      ],
      "decisionQuestion": "Which physically installed part/function corresponds to the rule, and is it registered in the effective object type under the correct functional parent?",
      "prohibitedShortcut": "invent_component_code_or_copy_part_from_neighboring_subgroup"
    },
    "subgroup_not_in_scope": {
      "discipline": "OEM_functional_architecture_and_SAP_functional_location",
      "evidenceClasses": [
        "serial_effective_system_schematic",
        "full_system_group_subgroup_path",
        "component_installation_and_routing"
      ],
      "decisionQuestion": "Does the complete OEM functional path of the installed assembly match the proposed SAP root, group and subgroup for this model?",
      "prohibitedShortcut": "alias_shared_HSVV_COMR_code_or_assign_subgroup_by_text_alone"
    }
  },
  "gates": [
    "private_model_serial_variant_identity",
    "serial_effective_OEM_BOM_and_schematic",
    "independent_mechanism_and_counterevidence",
    "engineering_review",
    "SAP_masterdata_change_control",
    "operational_authorization_if_relevant"
  ],
  "invariants": {
    "countPathsNotMachines": true,
    "noRiskScoreFromRejections": true,
    "keepPreexistingDocumentaryPriority": true,
    "noAutoSAPChange": true,
    "noClaimOEMEffectivity": true,
    "noActualAssetTagOrSerial": true,
    "noPrivateEvidenceInGitHub": true,
    "noRealDiagnosticsOrFieldInspections": true,
    "keepAllTenExceptionsBlocked": true,
    "allowWorkPacksForReviewOnly": true,
    "preserveIndependentOperationalAuthorization": true
  },
  "actionableUse": "Use the public report to order private documentary review by existing P0/P1 priority; review incompatible functional parent counts as observations of catalogue filtering, not defects in real machines."
}
