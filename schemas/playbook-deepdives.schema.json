{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMEA Mining — playbook differential deepdives v1.3.18",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "editorialNature",
    "mappingPolicy",
    "counts",
    "otherPlaybookIds",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "fmea-mining.playbook-deepdives.v1"
    },
    "version": {
      "const": "1.3.18"
    },
    "editorialNature": {
      "const": "roteiros_propostos_para_playbooks_sinteticos_sem_eventos_reais"
    },
    "mappingPolicy": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "required": [
        "playbooksInSource",
        "newDeepdives",
        "otherPlaybooksWithoutThisDeepDive",
        "proposedStages",
        "readinessRequirements",
        "eventsObserved",
        "causesConfirmed"
      ],
      "properties": {
        "playbooksInSource": {
          "const": 12
        },
        "newDeepdives": {
          "const": 6
        },
        "otherPlaybooksWithoutThisDeepDive": {
          "const": 6
        },
        "proposedStages": {
          "const": 18
        },
        "readinessRequirements": {
          "const": 24
        },
        "eventsObserved": {
          "const": 0
        },
        "causesConfirmed": {
          "const": 0
        }
      }
    },
    "otherPlaybookIds": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/deepDive"
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "methodId",
        "sourceTestId",
        "question",
        "signals",
        "nonDiscrimination",
        "requiredMetadata",
        "safeBoundary",
        "performed",
        "resultObserved",
        "oemEffective",
        "independentEvidenceVerified"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "methodId": {
          "type": "string",
          "pattern": "^EV-"
        },
        "sourceTestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 85
        },
        "signals": {
          "type": "object",
          "required": [
            "H1",
            "H2",
            "H3"
          ],
          "additionalProperties": false,
          "properties": {
            "H1": {
              "type": "string",
              "minLength": 65
            },
            "H2": {
              "type": "string",
              "minLength": 65
            },
            "H3": {
              "type": "string",
              "minLength": 65
            }
          }
        },
        "nonDiscrimination": {
          "type": "string",
          "minLength": 80
        },
        "requiredMetadata": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "safeBoundary": {
          "type": "string",
          "minLength": 90
        },
        "performed": {
          "const": false
        },
        "resultObserved": {
          "type": "null"
        },
        "oemEffective": {
          "const": false
        },
        "independentEvidenceVerified": {
          "const": false
        }
      }
    },
    "deepDive": {
      "type": "object",
      "required": [
        "id",
        "playbookId",
        "sourcePlaybookVersion",
        "originScenarioStatus",
        "system",
        "title",
        "modelIds",
        "objective",
        "hypotheses",
        "sourceTestIds",
        "stages",
        "readiness",
        "sourceIds",
        "sourceNature",
        "linkedCausalChainId",
        "serialOrArrangement",
        "sapLocationId",
        "confirmedComponentCode",
        "caseReview",
        "executionStatus",
        "observedEvents",
        "confirmedRootCause",
        "approvedForOperationalUse"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DEEP-"
        },
        "playbookId": {
          "type": "string",
          "pattern": "^PB-"
        },
        "originScenarioStatus": {
          "const": "cenario_autoral_sintetico"
        },
        "hypotheses": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3
        },
        "stages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "readiness": {
          "type": "object",
          "required": [
            "requires",
            "whenMissing",
            "whenComplete"
          ],
          "properties": {
            "requires": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "string"
              }
            },
            "whenMissing": {
              "const": "inconclusivo"
            },
            "whenComplete": {
              "const": "apto_para_revisao_nao_confirmado"
            }
          }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "sourceNature": {
          "const": "literatura_geral_sem_efetividade_de_serie"
        },
        "linkedCausalChainId": {
          "type": "null"
        },
        "serialOrArrangement": {
          "type": "null"
        },
        "sapLocationId": {
          "type": "null"
        },
        "confirmedComponentCode": {
          "type": "null"
        },
        "caseReview": {
          "type": "object",
          "required": [
            "engineering",
            "independent",
            "oem",
            "status"
          ]
        },
        "executionStatus": {
          "const": "not_performed"
        },
        "observedEvents": {
          "const": 0
        },
        "confirmedRootCause": {
          "const": false
        },
        "approvedForOperationalUse": {
          "const": false
        }
      }
    }
  }
}
