{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMEA Mining — systemic root cause editorial audit",
  "type": "object",
  "required": [
    "schema",
    "version",
    "purpose",
    "evidenceModel",
    "excluded",
    "policy",
    "counts",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "fmea-mining.systemic-root-audit.v1"
    },
    "version": {
      "const": "1.3.14"
    },
    "purpose": {
      "type": "string"
    },
    "evidenceModel": {
      "type": "string"
    },
    "excluded": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "required": [
        "mechanicalPlausibilityIsNotProcessProof",
        "automaticBlameForbidden",
        "noActualProcessRecords",
        "noRootCauseApproval",
        "independentReviewRequired"
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "expandedChains",
        "systemicClaims",
        "processDeviationsProven",
        "systemicRootCausesConfirmed",
        "priorPathwayChains",
        "totalAuditedChains"
      ],
      "properties": {
        "expandedChains": {
          "const": 21
        },
        "systemicClaims": {
          "const": 48
        },
        "processDeviationsProven": {
          "const": 0
        },
        "systemicRootCausesConfirmed": {
          "const": 0
        },
        "priorPathwayChains": {
          "const": 3
        },
        "totalAuditedChains": {
          "const": 24
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 24,
      "items": {
        "$ref": "#/$defs/chain"
      },
      "maxItems": 24
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "originalClaim",
        "hypothesisCategory",
        "minimumIndependentEvidence",
        "nonOrganizationalAlternative",
        "presentProofOfProcessDeviation",
        "processRecordsExamined",
        "attributedFaultToPeopleOrTeam",
        "causalConclusion",
        "actionsUntilVerified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SYS-FC-"
        },
        "originalClaim": {
          "type": "string"
        },
        "hypothesisCategory": {
          "type": "string"
        },
        "minimumIndependentEvidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 45
          }
        },
        "nonOrganizationalAlternative": {
          "type": "string",
          "minLength": 55
        },
        "presentProofOfProcessDeviation": {
          "const": false
        },
        "processRecordsExamined": {
          "const": false
        },
        "attributedFaultToPeopleOrTeam": {
          "const": false
        },
        "causalConclusion": {
          "const": "nao_demonstrada"
        },
        "actionsUntilVerified": {
          "type": "string"
        }
      }
    },
    "chain": {
      "type": "object",
      "required": [
        "chainId",
        "family",
        "originVersion",
        "status",
        "mechanicalHypothesisRetained",
        "systemicCauseUnverified",
        "reviewScope",
        "documentedPhysicalMechanism",
        "missingCausalBridge",
        "rootCandidateReviews",
        "sourcesGeneral",
        "applicabilityStatus",
        "reviewerPrimary",
        "reviewerIndependent",
        "reviewDecision",
        "systemicRootCauseConfirmed"
      ],
      "properties": {
        "chainId": {
          "type": "string",
          "pattern": "^FC-"
        },
        "family": {
          "type": "string"
        },
        "originVersion": {
          "enum": [
            "1.3.11",
            "1.3.12"
          ]
        },
        "status": {
          "const": "revisao_critica_editorial_nao_homologacao"
        },
        "mechanicalHypothesisRetained": {
          "const": true
        },
        "systemicCauseUnverified": {
          "const": true
        },
        "reviewScope": {
          "type": "string"
        },
        "documentedPhysicalMechanism": {
          "type": "string"
        },
        "missingCausalBridge": {
          "type": "string"
        },
        "rootCandidateReviews": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "sourcesGeneral": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "applicabilityStatus": {
          "const": "nao_verificada_por_serie"
        },
        "reviewerPrimary": {
          "type": "null"
        },
        "reviewerIndependent": {
          "type": "null"
        },
        "reviewDecision": {
          "type": "null"
        },
        "systemicRootCauseConfirmed": {
          "const": false
        }
      }
    }
  }
}
