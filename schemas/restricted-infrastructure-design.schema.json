{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMEA Mining Restricted Corporate Infrastructure Blueprint v1.3.24",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "maturity",
    "sourcePolicy",
    "deployment",
    "architecture",
    "roles",
    "operations",
    "permissions",
    "deniedOperationsRegardlessOfRole",
    "authRequirements",
    "segregation",
    "audit",
    "retention",
    "privacyAndRights",
    "normativeReferences",
    "backlog"
  ],
  "properties": {
    "schema": {
      "const": "fmea-mining.restricted-infrastructure-design.v1"
    },
    "version": {
      "const": "1.3.24"
    },
    "maturity": {
      "const": "architecture_specification_no_live_services"
    },
    "sourcePolicy": {
      "const": "data/governance/restricted-evidence-workflow.v1.json"
    },
    "deployment": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "const": false
      }
    },
    "architecture": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "component",
          "required",
          "owner",
          "live"
        ],
        "properties": {
          "live": {
            "const": false
          },
          "required": {
            "type": "string",
            "minLength": 65
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8
    },
    "operations": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11
    },
    "permissions": {
      "type": "object"
    },
    "deniedOperationsRegardlessOfRole": {
      "type": "array",
      "contains": {
        "const": "export_public"
      }
    },
    "authRequirements": {
      "type": "object",
      "additionalProperties": {
        "const": true
      }
    },
    "segregation": {
      "type": "array",
      "minItems": 3
    },
    "audit": {
      "type": "object",
      "required": [
        "allowedActions",
        "requiredFields",
        "forbiddenPayloads",
        "algorithm",
        "requireExternalTrustedAnchor",
        "requireAppendOnlyLogService",
        "requireIndependentTimeSource",
        "requireDataMinimization",
        "implementationStatus"
      ],
      "properties": {
        "requireExternalTrustedAnchor": {
          "const": true
        },
        "requireAppendOnlyLogService": {
          "const": true
        },
        "requireIndependentTimeSource": {
          "const": true
        },
        "requireDataMinimization": {
          "const": true
        },
        "implementationStatus": {
          "const": "offline_synthetic_demonstration_not_immutable_or_signed"
        }
      }
    },
    "retention": {
      "type": "object",
      "required": [
        "scheduleDays",
        "definedByCorporateRecordsOwner",
        "legalHoldOverridesDeletion",
        "disposalApproverRoles",
        "distinctApprovers",
        "mustVerifyBackupCopies",
        "requireDispositionReceipt",
        "sanitizerGuidance",
        "implementationStatus"
      ],
      "properties": {
        "scheduleDays": {
          "type": "null"
        },
        "definedByCorporateRecordsOwner": {
          "const": false
        },
        "legalHoldOverridesDeletion": {
          "const": true
        },
        "implementationStatus": {
          "const": "pure_eligibility_simulator_no_deletion"
        }
      }
    },
    "privacyAndRights": {
      "type": "object",
      "additionalProperties": {
        "const": true
      }
    },
    "normativeReferences": {
      "type": "array",
      "minItems": 2
    },
    "backlog": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "task",
          "status",
          "owner"
        ],
        "properties": {
          "status": {
            "const": "not_implemented"
          }
        }
      }
    }
  }
}
