{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hydraulic hose differential, conceptual only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "nature",
    "scope",
    "globalSafety",
    "policy",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "fmea-mining.hydraulic-hose-differential.v1"
    },
    "version": {
      "const": "1.3.89"
    },
    "nature": {
      "const": "conceptual_technical_differentials_not_field_diagnostics"
    },
    "scope": {
      "type": "object",
      "required": [
        "system",
        "componentFamily",
        "pmRules",
        "sapBlocker",
        "operationalPriorityAssigned"
      ]
    },
    "globalSafety": {
      "type": "string",
      "minLength": 150
    },
    "policy": {
      "type": "object",
      "required": [
        "conceptualOnly",
        "oemSerialRequired",
        "independentReviewRequired",
        "noAutomaticSapMapping",
        "noAutomaticWorkOrder",
        "noPressurizedLeakSearch",
        "noOperatingRelease",
        "noUniversalThresholds",
        "recordedFieldEvents",
        "performedInspections",
        "engineeringApprovals",
        "privateCorporateGates"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": [
          "id",
          "signal",
          "potentialFunctionalEffect",
          "disposition",
          "competingHypotheses",
          "evidenceToRequest",
          "sourceIds",
          "interpretationLimit",
          "observedOnAsset",
          "performedTests",
          "confirmedDamage",
          "confirmedRootCause",
          "approvedMeasurementLimit",
          "validatedOemSerial",
          "approvedSapMapping",
          "independentReview"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HH-DIFF-[0-9]{2}$"
          },
          "signal": {
            "type": "string",
            "minLength": 25
          },
          "potentialFunctionalEffect": {
            "type": "string",
            "minLength": 20
          },
          "disposition": {
            "enum": [
              "isolate_and_verify_origin_safely",
              "inspect_without_operating_release",
              "withdraw_from_service_evaluate_replacement",
              "withdraw_from_service_if_confirmed"
            ]
          },
          "competingHypotheses": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "id",
                "mechanism",
                "proposedDiscriminant",
                "competingExplanation"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "mechanism": {
                  "type": "string",
                  "minLength": 12
                },
                "proposedDiscriminant": {
                  "type": "string",
                  "minLength": 20
                },
                "competingExplanation": {
                  "type": "string",
                  "minLength": 20
                }
              }
            }
          },
          "evidenceToRequest": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 12
            }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "interpretationLimit": {
            "type": "string",
            "minLength": 35
          },
          "observedOnAsset": {
            "const": false
          },
          "performedTests": {
            "const": 0
          },
          "confirmedDamage": {
            "const": false
          },
          "confirmedRootCause": {
            "const": false
          },
          "approvedMeasurementLimit": {
            "type": "null"
          },
          "validatedOemSerial": {
            "type": "null"
          },
          "approvedSapMapping": {
            "const": false
          },
          "independentReview": {
            "const": "not_performed"
          }
        }
      }
    }
  }
}
