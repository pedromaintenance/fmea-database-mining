{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMEA Mining — Propostas de refinamento de mecanismos v1.3.22",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "nature",
    "context",
    "policy",
    "counts",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "fmea-mining.mechanism-refinements.v1"
    },
    "version": {
      "const": "1.3.22"
    },
    "nature": {
      "const": "candidate_only_no_oem_effectivity"
    },
    "context": {
      "type": "object"
    },
    "policy": {
      "type": "object",
      "required": [
        "doNotUpdateOntology",
        "doNotCreateFC",
        "doNotTransferVanePumpValuesToCAT395",
        "doNotConfuseCaseDrainWithTotalInternalLeakage",
        "doNotTreatISOTaxonomyAsRootCauseAnalysis",
        "independentReviewRequired"
      ],
      "properties": {
        "doNotUpdateOntology": {
          "const": true
        },
        "doNotCreateFC": {
          "const": true
        },
        "doNotTransferVanePumpValuesToCAT395": {
          "const": true
        },
        "doNotConfuseCaseDrainWithTotalInternalLeakage": {
          "const": true
        },
        "doNotTreatISOTaxonomyAsRootCauseAnalysis": {
          "const": true
        },
        "independentReviewRequired": {
          "const": true
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "refinements",
        "internalLeakageCandidates",
        "gearSubmodes",
        "newApprovedMechanismIds",
        "newApprovedCoreChains",
        "fieldObservations",
        "OEMApprovals"
      ],
      "properties": {
        "refinements": {
          "const": 4
        },
        "internalLeakageCandidates": {
          "const": 1
        },
        "gearSubmodes": {
          "const": 3
        },
        "newApprovedMechanismIds": {
          "const": 0
        },
        "newApprovedCoreChains": {
          "const": 0
        },
        "fieldObservations": {
          "const": 0
        },
        "OEMApprovals": {
          "const": 0
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/refinement"
      }
    }
  },
  "$defs": {
    "refinement": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "parentProposalId",
        "family",
        "parentMechanismId",
        "label",
        "physicalDefinition",
        "mechanicalFunction",
        "functionalFailureId",
        "causalPosition",
        "safeBoundary",
        "sourceIds",
        "sourceUseLimit",
        "observedParameterValues",
        "approvedThreshold",
        "applicableSerialOrArrangement",
        "observedPhysicalDamage",
        "actualFieldOccurrences",
        "independentReviewStatus",
        "approvedNewOntologyId",
        "approvedCoreChainId",
        "confirmedRootCause",
        "editorialState"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "candidate_mechanism_concept",
            "proposed_gear_damage_submode"
          ]
        },
        "parentProposalId": {
          "type": "string",
          "pattern": "^CAND-"
        },
        "functionalFailureId": {
          "const": "FF-02"
        },
        "causalPosition": {
          "enum": [
            "candidate_physical_mechanism_not_root_cause",
            "candidate_damage_mechanism_not_observed"
          ]
        },
        "parentMechanismId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceIds": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "observedParameterValues": {
          "type": "null"
        },
        "approvedThreshold": {
          "type": "null"
        },
        "applicableSerialOrArrangement": {
          "type": "null"
        },
        "observedPhysicalDamage": {
          "type": "null"
        },
        "actualFieldOccurrences": {
          "const": 0
        },
        "independentReviewStatus": {
          "const": "not_reviewed"
        },
        "approvedNewOntologyId": {
          "type": "null"
        },
        "approvedCoreChainId": {
          "type": "null"
        },
        "confirmedRootCause": {
          "const": false
        },
        "editorialState": {
          "const": "proposal_only"
        }
      }
    }
  }
}
