{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMEA Mining — public contract compatibility baseline",
  "type": "object",
  "required": [
    "schema",
    "version",
    "contractVersion",
    "existingPreviewSchema",
    "existingPreviewVersion",
    "existingManifestSchema",
    "compatibilityReference",
    "versioningPolicy",
    "independentCompatibilityTestPolicy",
    "unsafeSemanticChanges",
    "note"
  ],
  "properties": {
    "schema": {
      "const": "fmea-mining.public-contract.v1"
    },
    "version": {
      "const": "1.3.34"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "existingPreviewSchema": {
      "const": "fmea-mining.public-knowledge-preview.v1"
    },
    "existingPreviewVersion": {
      "const": "1.3.12"
    },
    "existingManifestSchema": {
      "const": "fmea-mining.public-knowledge-manifest.v1"
    },
    "compatibilityReference": {
      "type": "object",
      "required": [
        "sourceRelease",
        "sha256",
        "recordCount",
        "sourceCount",
        "publicChainFields",
        "publicSourceFields"
      ],
      "properties": {
        "sourceRelease": {
          "const": "1.3.12"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recordCount": {
          "const": 24
        },
        "sourceCount": {
          "const": 20
        },
        "publicChainFields": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "string"
          }
        },
        "publicSourceFields": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "versioningPolicy": {
      "type": "object",
      "required": [
        "major",
        "minor",
        "patch",
        "independentFromPackageRelease",
        "noSilentSchemaDrift",
        "noAutomaticEvidencePromotion",
        "enforceFormerPreviewByteIdentityUntilExplicitRevision"
      ]
    },
    "independentCompatibilityTestPolicy": {
      "type": "object"
    },
    "unsafeSemanticChanges": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    }
  }
}
