{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMEA Mining — public knowledge preview contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "contentStatus",
    "approvedForOperationalUse",
    "recordNature",
    "sourceScope",
    "warnings",
    "counts",
    "records",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "fmea-mining.public-knowledge-preview.v1"
    },
    "version": {
      "const": "1.3.12"
    },
    "contentStatus": {
      "const": "conceptual_inferred_unvalidated"
    },
    "approvedForOperationalUse": {
      "const": false
    },
    "recordNature": {
      "const": "hypotheses_only"
    },
    "sourceScope": {
      "const": "general_principles_not_serial_effective"
    },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "causalChains",
        "sources",
        "confirmedRootCauses",
        "empiricalOccurrences"
      ],
      "properties": {
        "causalChains": {
          "const": 24
        },
        "sources": {
          "type": "integer",
          "minimum": 1
        },
        "confirmedRootCauses": {
          "const": 0
        },
        "empiricalOccurrences": {
          "const": 0
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 24,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "organization",
        "url",
        "role",
        "limitation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "family",
        "operatingFunction",
        "functionalFailureId",
        "failureMode",
        "mechanismIds",
        "sourceIds",
        "causalLevels",
        "localEffect",
        "systemEffect",
        "competingHypotheses",
        "investigations",
        "applicability",
        "reviewStatus",
        "nature",
        "confirmedRootCause",
        "empiricalOccurrences"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FC-"
        },
        "title": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "operatingFunction": {
          "type": "string"
        },
        "functionalFailureId": {
          "type": "string"
        },
        "failureMode": {
          "type": "string"
        },
        "mechanismIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "causalLevels": {
          "type": "object",
          "required": [
            "observedPhenomenon",
            "immediatePhysicalMechanismCandidate",
            "contributingConditionCandidates",
            "rootCauseCandidates",
            "rootCauseNotEstablishedBecause"
          ]
        },
        "localEffect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "status"
          ],
          "properties": {
            "description": {
              "type": "string"
            },
            "status": {
              "const": "possible_unobserved"
            }
          }
        },
        "systemEffect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "status"
          ],
          "properties": {
            "description": {
              "type": "string"
            },
            "status": {
              "const": "possible_unobserved"
            }
          }
        },
        "competingHypotheses": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "discriminator"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "discriminator": {
                "type": "string"
              }
            }
          }
        },
        "investigations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "methodId",
              "purpose",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "methodId": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "status": {
                "const": "not_performed"
              }
            }
          }
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelId",
            "locationId",
            "serialOrArrangement"
          ],
          "properties": {
            "modelId": {
              "type": "null"
            },
            "locationId": {
              "type": "null"
            },
            "serialOrArrangement": {
              "type": "null"
            }
          }
        },
        "reviewStatus": {
          "const": "inferido_com_literatura_geral"
        },
        "nature": {
          "const": "hypothesis_not_event"
        },
        "confirmedRootCause": {
          "const": false
        },
        "empiricalOccurrences": {
          "const": 0
        }
      }
    }
  }
}
