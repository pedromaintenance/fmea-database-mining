{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMEA Mining - taxonomy audit of proposed candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "nature",
    "references",
    "counts",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "fmea-mining.proposal-taxonomy-audit.v1"
    },
    "version": {
      "const": "1.3.21"
    },
    "nature": {
      "const": "editorial_ontology_coherence_only"
    },
    "references": {
      "type": "object"
    },
    "counts": {
      "type": "object",
      "required": [
        "reviewedCandidates",
        "functionClassifications",
        "mechanismOntologyGap",
        "mechanismsRequiringSplit",
        "approvedCorePromotions",
        "observedEvents",
        "existingCoreChains"
      ],
      "properties": {
        "reviewedCandidates": {
          "const": 3
        },
        "functionClassifications": {
          "const": 3
        },
        "mechanismOntologyGap": {
          "const": 1
        },
        "mechanismsRequiringSplit": {
          "const": 1
        },
        "approvedCorePromotions": {
          "const": 0
        },
        "observedEvents": {
          "const": 0
        },
        "existingCoreChains": {
          "const": 24
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "mechanism": {
      "type": "object",
      "required": [
        "mechanismId",
        "fit",
        "limit"
      ],
      "properties": {
        "mechanismId": {
          "type": "string",
          "pattern": "^ME-"
        },
        "fit": {
          "type": "string"
        },
        "limit": {
          "type": "string",
          "minLength": 55
        }
      }
    },
    "overlap": {
      "type": "object",
      "required": [
        "coreId",
        "relation",
        "distinction"
      ],
      "properties": {
        "coreId": {
          "type": "string",
          "pattern": "^FC-"
        },
        "relation": {
          "type": "string"
        },
        "distinction": {
          "type": "string",
          "minLength": 75
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "proposalId",
        "originPlaybookId",
        "originHypothesisId",
        "sourceProposalVersion",
        "originalMechanismText",
        "originalFunctionText",
        "functionAudit",
        "mechanismAudit",
        "ontologyGap",
        "coreOverlaps",
        "possibleEffects",
        "alternativeExplanation",
        "auditFinding",
        "disposition",
        "requiredBeforePromotion",
        "approvedCoreId",
        "approvedSapLocation",
        "applicableSerial",
        "observedEffect",
        "reviewerTechnical",
        "reviewerIndependent",
        "reviewDecision",
        "confirmedRootCause"
      ],
      "properties": {
        "proposalId": {
          "type": "string",
          "pattern": "^CAND-"
        },
        "originPlaybookId": {
          "type": "string",
          "pattern": "^PB-"
        },
        "originHypothesisId": {
          "enum": [
            "H1",
            "H2",
            "H3"
          ]
        },
        "functionAudit": {
          "type": "object",
          "required": [
            "existingFunctionalFailureId",
            "criterionFromOntology",
            "rationale",
            "classification"
          ],
          "properties": {
            "existingFunctionalFailureId": {
              "type": "string",
              "pattern": "^FF-"
            },
            "classification": {
              "const": "proposed_not_verified"
            }
          }
        },
        "mechanismAudit": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mechanism"
          }
        },
        "ontologyGap": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "label",
                "conceptId",
                "status",
                "rationale"
              ],
              "properties": {
                "conceptId": {
                  "type": "null"
                },
                "status": {
                  "const": "needs_ontology_definition"
                }
              }
            }
          ]
        },
        "coreOverlaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/overlap"
          }
        },
        "possibleEffects": {
          "type": "object",
          "required": [
            "local",
            "system",
            "status",
            "severity",
            "probability"
          ],
          "properties": {
            "status": {
              "const": "possible_unobserved"
            },
            "severity": {
              "type": "null"
            },
            "probability": {
              "type": "null"
            }
          }
        },
        "requiredBeforePromotion": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 80
          }
        },
        "approvedCoreId": {
          "type": "null"
        },
        "approvedSapLocation": {
          "type": "null"
        },
        "applicableSerial": {
          "type": "null"
        },
        "observedEffect": {
          "type": "null"
        },
        "reviewerTechnical": {
          "type": "null"
        },
        "reviewerIndependent": {
          "type": "null"
        },
        "reviewDecision": {
          "type": "null"
        },
        "confirmedRootCause": {
          "const": false
        }
      }
    }
  }
}
