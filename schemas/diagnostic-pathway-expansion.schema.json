{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMEA Mining — Diagnostic pathway expansion v1.3.17",
  "type": "object",
  "required": [
    "schema",
    "version",
    "nature",
    "strategy",
    "policy",
    "counts",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "fmea-mining.diagnostic-pathway-expansion.v1"
    },
    "version": {
      "const": "1.3.17"
    },
    "nature": {
      "const": "didatico_tecnico_sem_inspecao_executada"
    },
    "strategy": {
      "const": "complemento_aditivo_preservando_os_tres_roteiros_originais"
    },
    "policy": {
      "type": "object"
    },
    "counts": {
      "type": "object",
      "properties": {
        "previousPathways": {
          "const": 3
        },
        "newPathways": {
          "const": 3
        },
        "totalDetailedPathways": {
          "const": 6
        },
        "proposedInvestigationStages": {
          "const": 9
        },
        "observedEvents": {
          "const": 0
        },
        "confirmedRootCauses": {
          "const": 0
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/path"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "id",
        "methodId",
        "question",
        "supportsA",
        "supportsB",
        "notDiscriminating",
        "requiredMetadata",
        "safeBoundary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "methodId": {
          "type": "string",
          "pattern": "^EV-"
        },
        "question": {
          "type": "string",
          "minLength": 55
        },
        "supportsA": {
          "type": "string",
          "minLength": 55
        },
        "supportsB": {
          "type": "string",
          "minLength": 55
        },
        "notDiscriminating": {
          "type": "string",
          "minLength": 55
        },
        "requiredMetadata": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "safeBoundary": {
          "type": "string",
          "minLength": 55
        }
      }
    },
    "path": {
      "type": "object",
      "required": [
        "id",
        "chainId",
        "focusAlternativeId",
        "originCrossRefId",
        "title",
        "detection",
        "comparison",
        "steps",
        "causalLevels",
        "evidenceGate",
        "sourceIds",
        "applicableModelId",
        "applicableSapLocationId",
        "confirmedPartCode",
        "applicableSerialOrArrangement",
        "executionStatus",
        "resultObserved",
        "diagnosticConclusion",
        "reviewStatus",
        "fieldEvents",
        "rootCauseConfirmed",
        "independentEvidenceVerified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PATH-"
        },
        "chainId": {
          "type": "string",
          "pattern": "^FC-"
        },
        "focusAlternativeId": {
          "enum": [
            "ALT1",
            "ALT2"
          ]
        },
        "originCrossRefId": {
          "type": "string",
          "pattern": "^XREF-"
        },
        "title": {
          "type": "string",
          "minLength": 60
        },
        "detection": {
          "type": "string",
          "minLength": 100
        },
        "comparison": {
          "type": "object",
          "required": [
            "hypothesisA",
            "hypothesisB"
          ],
          "properties": {
            "hypothesisA": {
              "type": "string",
              "minLength": 45
            },
            "hypothesisB": {
              "type": "string"
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "causalLevels": {
          "type": "object",
          "required": [
            "observedPhenomenon",
            "immediatePhysicalMechanismCandidate",
            "contributingConditionCandidates",
            "rootCauseCandidates",
            "rootCauseNotEstablishedBecause"
          ]
        },
        "evidenceGate": {
          "type": "object",
          "required": [
            "requires",
            "decisionWithoutEvidence"
          ],
          "properties": {
            "requires": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "string"
              }
            },
            "decisionWithoutEvidence": {
              "const": "inconclusivo"
            }
          }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "applicableModelId": {
          "type": "null"
        },
        "applicableSapLocationId": {
          "type": "null"
        },
        "confirmedPartCode": {
          "type": "null"
        },
        "applicableSerialOrArrangement": {
          "type": "null"
        },
        "executionStatus": {
          "const": "not_performed"
        },
        "resultObserved": {
          "type": "null"
        },
        "diagnosticConclusion": {
          "type": "null"
        },
        "reviewStatus": {
          "const": "proposta_editorial_nao_homologada"
        },
        "fieldEvents": {
          "const": 0
        },
        "rootCauseConfirmed": {
          "const": false
        },
        "independentEvidenceVerified": {
          "const": false
        }
      }
    }
  }
}
