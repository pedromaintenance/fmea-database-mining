{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMEA Mining — public content release registry (not contract version)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registryVersion",
    "currentContentRelease",
    "policyPath",
    "releases"
  ],
  "properties": {
    "schema": {
      "const": "fmea-mining.public-content-releases.v1"
    },
    "registryVersion": {
      "const": "1.0.0"
    },
    "currentContentRelease": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "policyPath": {
      "const": "data/governance/public-content-release-policy.v1.json"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentVersion",
        "contractVersion",
        "historicalPreviewVersion",
        "snapshotPath",
        "sha256",
        "recordCount",
        "sourceCount",
        "characterization",
        "review",
        "notes"
      ],
      "properties": {
        "contentVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "contractVersion": {
          "type": "string"
        },
        "historicalPreviewVersion": {
          "type": "string"
        },
        "snapshotPath": {
          "type": "string",
          "pattern": "^data/governance/snapshots/public-knowledge\\.content-"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "sourceCount": {
          "type": "integer",
          "minimum": 0
        },
        "characterization": {
          "type": "string"
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "editorialReviewer",
            "independentReviewer",
            "approvedForOperationalUse"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "editorialReviewer": {
              "type": [
                "null",
                "string"
              ]
            },
            "independentReviewer": {
              "type": [
                "null",
                "string"
              ]
            },
            "approvedForOperationalUse": {
              "const": false
            }
          }
        },
        "notes": {
          "type": "string"
        },
        "changeLog": {
          "type": "string"
        }
      }
    }
  }
}
