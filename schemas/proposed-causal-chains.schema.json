{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidatos editoriais de cadeias físicas FMEA — sem incorporação ao núcleo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "purpose",
    "policy",
    "counts",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "fmea-mining.proposed-causal-chains.v1"
    },
    "version": {
      "const": "1.3.20"
    },
    "purpose": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "additionalProperties": {
        "const": true
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "existingCoreChains",
        "proposedChains",
        "addedToCore",
        "observedEvents",
        "confirmedRootCauses"
      ],
      "properties": {
        "existingCoreChains": {
          "const": 24
        },
        "proposedChains": {
          "const": 3
        },
        "addedToCore": {
          "const": 0
        },
        "observedEvents": {
          "const": 0
        },
        "confirmedRootCauses": {
          "const": 0
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "test": {
      "type": "object",
      "required": [
        "methodId",
        "question",
        "positiveOnlyIf",
        "counterEvidence",
        "safeBoundary"
      ],
      "properties": {
        "methodId": {
          "type": "string",
          "pattern": "^EV-"
        },
        "question": {
          "type": "string",
          "minLength": 80
        },
        "positiveOnlyIf": {
          "type": "string",
          "minLength": 75
        },
        "counterEvidence": {
          "type": "string",
          "minLength": 70
        },
        "safeBoundary": {
          "type": "string",
          "minLength": 85
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "family",
        "relatedPlaybookId",
        "relatedHypothesisId",
        "title",
        "operatingFunction",
        "functionalFailureCandidate",
        "physicalMechanismCandidate",
        "possibleDamage",
        "alternativeHypotheses",
        "diagnosticTests",
        "minimumIndependentEvidence",
        "sources",
        "nonOrganizationalAlternative",
        "classification",
        "editorialDisposition",
        "promotedToCore",
        "applicableSerialOrArrangement",
        "approvedModelId",
        "approvedSapLocation",
        "partNumber",
        "measuredThreshold",
        "fieldObservation",
        "review",
        "observedOccurrences",
        "confirmedRootCause"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CAND-"
        },
        "relatedPlaybookId": {
          "type": "string",
          "pattern": "^PB-"
        },
        "relatedHypothesisId": {
          "enum": [
            "H1",
            "H2",
            "H3"
          ]
        },
        "classification": {
          "const": "mechanical_failure_mode_candidate"
        },
        "editorialDisposition": {
          "const": "proposta_de_nova_cadeia_nao_integrada"
        },
        "promotedToCore": {
          "const": false
        },
        "applicableSerialOrArrangement": {
          "type": "null"
        },
        "approvedModelId": {
          "type": "null"
        },
        "approvedSapLocation": {
          "type": "null"
        },
        "partNumber": {
          "type": "null"
        },
        "measuredThreshold": {
          "type": "null"
        },
        "fieldObservation": {
          "type": "null"
        },
        "observedOccurrences": {
          "const": 0
        },
        "confirmedRootCause": {
          "const": false
        },
        "minimumIndependentEvidence": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 75
          }
        },
        "sources": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "alternativeHypotheses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        },
        "diagnosticTests": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "const": "not_reviewed"
            },
            "technicalReviewer": {
              "type": "null"
            },
            "independentReviewer": {
              "type": "null"
            },
            "decision": {
              "type": "null"
            }
          }
        }
      }
    }
  }
}
