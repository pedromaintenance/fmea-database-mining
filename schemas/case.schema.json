{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromaintenance/fmea-database-mining/blob/main/schemas/case.schema.json",
  "title": "PORCARIA FMEA Case (didactic) v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "modelId",
    "locationId",
    "componentCode",
    "damageId",
    "causeId",
    "operatorReport",
    "hypotheses",
    "evidence",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "modelId": {
      "type": "string",
      "minLength": 2
    },
    "locationId": {
      "type": "string",
      "minLength": 3
    },
    "componentCode": {
      "type": "string",
      "minLength": 1
    },
    "damageId": {
      "type": "string",
      "minLength": 1
    },
    "causeId": {
      "type": "string",
      "minLength": 1
    },
    "operatorReport": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "enum": [
        "inferido",
        "curado",
        "validado",
        "empirico"
      ]
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "suspeita",
              "corroborada",
              "refutada",
              "confirmada"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "method",
          "result",
          "interpretation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "interpretation": {
            "enum": [
              "sustenta",
              "refuta",
              "inconclusiva"
            ]
          },
          "hypothesisIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pendente",
            "revisado",
            "aprovado"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "gameplay": {
      "type": "object"
    }
  }
}
